{
  "name": "muster",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "test": "bun test --timeout 30000 packages apps",
    "test:coverage": "bun test --timeout 30000 --coverage packages apps && bun scripts/checkCoverage.mjs",
    "test:e2e": "bun --filter @muster/e2e test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:duplication": "bunx jscpd",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run build:server && bun run build:web",
    "build:server": "bun build apps/server/src/index.ts --target=bun --outfile dist/server.js",
    "build:web": "bun --filter @muster/web build",
    "check:bundle": "bun scripts/checkBundle.mjs dist/server.js",
    "dev:setup": "bun scripts/devSetup.ts",
    "dev": "overmind start -w muster-dev -F .overmind.tmux.conf",
    "dev:seed": "bun scripts/seed.ts",
    "stack:up": "docker compose -f deploy/docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose -f deploy/docker-compose.yml down -v",
    "stack:logs": "docker compose -f deploy/docker-compose.yml logs",
    "stack:seed": "bun --env-file=deploy/stack.env scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@muster/core": "workspace:*",
    "@muster/db": "workspace:*",
    "@types/bun": "^1.3.14",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "^17.11.0",
    "jscpd": "^5.0.15",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
