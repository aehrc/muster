# What the repository's commands read. Copy the sections you need into `.env.test`
# and `.env.local`, which Git ignores.
#
# Bun loads `.env` files from the working directory and does not search upwards, so
# this file describes the variables for commands run from the repository root.
#
# The two sections go in different files, and that is Bun's rule rather than a
# convention: `bun test` sets NODE_ENV=test, and Bun does not load `.env.local` in
# that mode - it loads `.env` and `.env.test`.

# --- .env.test ---------------------------------------------------------------
# The throwaway database the suites may migrate, create roles in and write to. Named
# by the identity that owns the schema: the test preload creates a non-owning serving
# role from it and every integration suite connects as that, because a suite running
# as the owner would pass whether or not the grants in `packages/db/src/roles.ts`
# were correct.
#
# Leaving it unset does not fail the run - the integration suites skip themselves,
# and the run reports success having exercised no database at all. CI sets it, so a
# skip there is a failure of the workflow. Check for a `skip` count if you are not
# sure it is being read.
MUSTER_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55433/muster_test

# --- .env.local --------------------------------------------------------------
# The development database, in the two identities a deployment runs as. The owner
# applies migrations; the server serves and cannot issue DDL.
MUSTER_DATABASE_OWNER_URL=postgresql://muster:muster@localhost:55434/muster
MUSTER_DATABASE_URL=postgresql://muster_app:muster_app@localhost:55434/muster

# Every public URL Muster emits - issuer identifiers, verification links, JWKS and
# brands addresses - derives from this one.
MUSTER_PUBLIC_URL=http://localhost:3000

# Encrypts signing private keys at rest. 32 bytes, hex or base64url encoded.
MUSTER_MASTER_KEY=0123456789abcdef0123456789abcdef

# Where to send mail. Unset means the console transport, which logs the rendered
# message instead of sending it.
# MUSTER_SMTP_URL=smtp://localhost:1025

# The From address on every message. Defaults to `muster@<host of MUSTER_PUBLIC_URL>`,
# which a relay may refuse - set it explicitly when it does.
# MUSTER_MAIL_FROM=Muster <no-reply@example.org>

# Hosts the outbound guard may reach on a private address or over plain HTTP, as a
# comma-separated list of `host` or `host:port`. Empty by default: the guard refuses
# every private, loopback, link-local and metadata address unless the host is named
# here. For development and connectathon stacks whose stubs sit on a compose network;
# never in production.
# MUSTER_OUTBOUND_ALLOWED_HOSTS=stub-server:8080,stub-holder:8080

# How often an open event's enrolled servers are verified, in minutes. Fifteen by
# default, which is the ceiling SC-004 puts on it: an unreachable server is visibly
# flagged within one check interval. A draft event's servers are checked every 24
# intervals and a closed event's every 96, so shortening this shortens everything.
# MUSTER_CHECK_INTERVAL_MINUTES=15

# debug, info (default), warn or error.
# MUSTER_LOG_LEVEL=info

# Where the built console lives, served for any path the API does not claim. Unset in
# development, where Vite serves it and proxies `/api` to the server.
# MUSTER_WEB_ROOT=/app/web
