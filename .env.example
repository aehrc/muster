# Muster's native dev environment - no Docker.
#
# `cp .env.example .env`. Bun loads `.env` automatically for every process
# that runs here: the server, `bun run test`, and the seed script. Nothing
# below is a secret - it is a development-only role on a local database with
# no network exposure.
#
# Ports are deliberately different from deploy/docker-compose.yml's, so that
# stack (which backs the e2e suite) can run at the same time as this one
# without either colliding with the other.
#
# Author: John Grimes

MUSTER_PUBLIC_URL=http://localhost:8090
MUSTER_PORT=8090
MUSTER_MASTER_KEY=development-master-key-not-for-deployment

# One role for both: `bun run dev:setup` creates it. The server bootstraps its
# own non-owning serving role (muster_server) the first time it starts.
MUSTER_DATABASE_URL=postgresql://muster:muster@localhost:5432/muster
MUSTER_MIGRATION_DATABASE_URL=postgresql://muster:muster@localhost:5432/muster
MUSTER_MIGRATIONS_DIRECTORY=packages/db/migrations

# The stubs sit on localhost, not a compose network, so nothing about them is
# private - but the address guard still refuses a plain http endpoint unless
# its host is named here, which is what lets a registration run reach them.
MUSTER_OUTBOUND_ALLOWLIST=localhost:9190,localhost:9191,localhost:9192

# The recorded persona fixture the seed points the seeded event at.
MUSTER_SEED_PERSONA_SOURCE_URL=http://localhost:9192/fhir

# Read by `bun run test`'s integration suites; unset, they skip visibly.
# `bun run dev:setup` creates this database.
MUSTER_TEST_DATABASE_URL=postgresql://muster:muster@localhost:5432/muster_test
