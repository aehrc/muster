# The local stack's environment, as seen from the host.
#
# `bun run stack:seed` reads this so that the seed script talks to the database the
# compose stack publishes on 5433 without anything having to be exported by hand.
# The values match deploy/docker-compose.yml, except for the two addresses: inside
# the network the database is `postgres:5432` and Muster is `muster:8080`, and from
# here they are localhost with the published ports.
#
# One caveat: `bun --env-file` leaves a variable the shell already exports alone,
# so a shell that has MUSTER_DATABASE_URL set for its own database keeps it. The
# seed states which database it is seeding for exactly that reason.
#
# Nothing in here is a secret. The stack is a development stack, its database is
# a container with a volume, and the master key encrypts signing keys that exist
# only in it.
#
# Author: John Grimes

MUSTER_PUBLIC_URL=http://localhost:8080
MUSTER_MASTER_KEY=development-master-key-not-for-deployment
MUSTER_MIGRATION_DATABASE_URL=postgresql://muster_owner:muster_owner@localhost:5433/muster
MUSTER_DATABASE_URL=postgresql://muster_server:muster_server@localhost:5433/muster
MUSTER_SERVER_DATABASE_ROLE=muster_server
MUSTER_SERVER_DATABASE_PASSWORD=muster_server
MUSTER_MIGRATIONS_DIRECTORY=packages/db/migrations

# The seed writes this onto the event it creates, and Muster reaches it over the
# compose network. It is the recorded fixture rather than the live Sparked
# server, so the persona scenarios do not depend on somebody else's uptime.
MUSTER_SEED_PERSONA_SOURCE_URL=http://persona-source-stub:9092/fhir

# Named so the seed's own endpoint check permits the http persona source above,
# for the same reason the Muster container names them: the guard refuses private
# addresses, and an http endpoint is refused, unless the host is named here.
MUSTER_OUTBOUND_ALLOWLIST=register-stub:9090,data-holder-stub:9091,persona-source-stub:9092
