{
  "threshold": 0,
  "minTokens": 60,
  "reporters": ["console"],
  "path": ["packages", "apps", "e2e", "scripts"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.tsbuild/**",
    "**/coverage/**",
    "**/migrations/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "absolute": true
}
